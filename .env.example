# Binance Futures DEMO
BINANCE_BASE_URL=https://demo-fapi.binance.com
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
FORCE_DEMO_ONLY=true

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Symbol / virtual working range
SYMBOL=SOLUSDT
LOWER_PRICE=80
UPPER_PRICE=120
GRID_COUNT=40000
VIRTUAL_GRID_STEP=0.001

# Position size
# ORDER_NOTIONAL_USDT is position notional WITH leverage.
# Example: 1000 notional at 10x uses about 100 USDT margin.
ORDER_NOTIONAL_USDT=1000
MARGIN_BUDGET_USDT=100
LEVERAGE=10

# Entry / adaptive reprice
ENTRY_OFFSET_PCT=0.0001
COUNTER_BIAS_OFFSET_PCT=0.0015
REPRICE_ENTRY_SECONDS=10
REPRICE_MIN_MOVE_PCT=0.00005

# Smart analysis
USE_SMART_ANALYSIS=true
SIGNAL_CONFIRM_SECONDS=20
ANALYSIS_REFRESH_SECONDS=5
BIAS_THRESHOLD=15
STRONG_BIAS_THRESHOLD=35
DISABLE_COUNTER_ON_STRONG_BIAS=false
MAX_SPREAD_PCT=0.0015
MAX_FAST_MOVE_PCT=0.012

# Take / stop
TAKE_NET_PROFIT=1.00
MAX_CYCLE_LOSS=-3.00
TAKE_EXCHANGE_UPNL=1.50
EXCHANGE_TAKE_MIN_NET=0.30
USE_TP_LIMIT_ORDER=true

# Speed / logs
CHECK_INTERVAL_SECONDS=0.25
PRINT_INTERVAL_SECONDS=2
TELEGRAM_STATUS_EVERY_SECONDS=60
LIVE_WALLET_IN_LOOP=false
DETAILED_TICK_LOG=true

# Runtime
TOTAL_RUNTIME_SECONDS=14400
COOLDOWN_SECONDS=20
LOSS_COOLDOWN_SECONDS=30
CLOSE_ON_START=true
CLOSE_ON_EXIT=false
