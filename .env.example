# Binance mode
BINANCE_BASE_URL=https://demo-fapi.binance.com
FORCE_DEMO_ONLY=true

# Secrets
BINANCE_API_KEY=your_key_here
BINANCE_SECRET_KEY=your_secret_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Trading
SYMBOL=DOGEUSDT
LOWER_PRICE=0.05
UPPER_PRICE=0.15
GRID_COUNT=10000
VIRTUAL_GRID_STEP=0.00001
ORDER_NOTIONAL_USDT=50
LEVERAGE=3

# Entry/adaptive analysis
ENTRY_OFFSET_PCT=0.0001
COUNTER_BIAS_OFFSET_PCT=0.0015
REPRICE_ENTRY_SECONDS=30
REPRICE_MIN_MOVE_PCT=0.00005
USE_SMART_ANALYSIS=true
SIGNAL_CONFIRM_SECONDS=20
ANALYSIS_REFRESH_SECONDS=60
BIAS_THRESHOLD=15
STRONG_BIAS_THRESHOLD=35
MAX_SPREAD_PCT=0.0015
MAX_FAST_MOVE_PCT=0.012

# Exit/risk
TAKE_NET_PROFIT=0.10
TAKE_EXCHANGE_UPNL=0.15
EXCHANGE_TAKE_MIN_NET=0.02
MAX_CYCLE_LOSS=-0.30
USE_TP_LIMIT_ORDER=true
TP_LIMIT_MAX_ATTEMPTS=1
TP_LIMIT_RETRY_SECONDS=300

# Runtime/API safety
TOTAL_RUNTIME_SECONDS=0
CHECK_INTERVAL_SECONDS=2
PRINT_INTERVAL_SECONDS=15
TELEGRAM_STATUS_EVERY_SECONDS=0
API_RETRY_SLEEP_SECONDS=30
API_RATE_LIMIT_SLEEP_SECONDS=60
API_BAN_SLEEP_SECONDS=300
API_MAX_BACKOFF_SECONDS=600
REQUEST_TIMEOUT_SECONDS=12
LIVE_WALLET_IN_LOOP=false
COOLDOWN_SECONDS=30
LOSS_COOLDOWN_SECONDS=60
CLOSE_ON_START=false
CLOSE_ON_EXIT=false
