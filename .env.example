# ===== Binance Futures DEMO =====
BINANCE_BASE_URL=https://demo-fapi.binance.com
BINANCE_API_KEY=PUT_YOUR_DEMO_API_KEY_HERE
BINANCE_SECRET_KEY=PUT_YOUR_DEMO_SECRET_KEY_HERE
FORCE_DEMO_ONLY=true

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=PUT_BOTFATHER_TOKEN_HERE
TELEGRAM_CHAT_ID=PUT_YOUR_CHAT_ID_HERE

# ===== Trading settings =====
SYMBOL=ONEUSDT
LOWER_PRICE=0.0023
UPPER_PRICE=0.0040
GRID_COUNT=40
MARGIN_BUDGET_USDT=100
LEVERAGE=10
ORDER_NOTIONAL_USDT=25
ACTIVE_LEVELS_EACH_SIDE=1

# Main logic: close only by Net est
TAKE_NET_PROFIT=0.10
MAX_CYCLE_LOSS=-0.40

# Runtime / cooldown
TOTAL_RUNTIME_SECONDS=14400
COOLDOWN_SECONDS=30
LOSS_COOLDOWN_SECONDS=30
CHECK_INTERVAL_SECONDS=0.5
PRINT_INTERVAL_SECONDS=5
TELEGRAM_STATUS_EVERY_SECONDS=300

# Network protection
REQUEST_TIMEOUT_SECONDS=12
API_RETRY_SLEEP_SECONDS=5
API_DOWNTIME_NOTIFY_EVERY_SECONDS=120

# Startup / exit safety
CLOSE_ON_START=true
CLOSE_ON_EXIT=false
